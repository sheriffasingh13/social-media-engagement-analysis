  <worksheets>
    <worksheet name='Engagement by Format'>
      <layout-options>
        <title><formatted-text><run bold='true' fontsize='12'>Median engagement rate by post format</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='Facebook posts' name='federated.0fbengagement000000000000' /></datasources>
          <datasource-dependencies datasource='federated.0fbengagement000000000000'>
<column caption='Engagement Rate' datatype='real' name='[engagement]' role='measure' type='quantitative' default-format='p0.00%' />
<column-instance column='[engagement]' derivation='Median' name='[med:engagement:qk]' pivot='key' type='quantitative' />
<column caption='Post Format' datatype='string' name='[format_label]' role='dimension' type='nominal' />
<column-instance column='[format_label]' derivation='None' name='[none:format_label:nk]' pivot='key' type='nominal' />
<column caption='Photo or Non-photo' datatype='string' name='[format_group]' role='dimension' type='nominal' />
<column-instance column='[format_group]' derivation='None' name='[none:format_group:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <shelf-sorts><shelf-sort-v2 dimension-to-sort='[federated.0fbengagement000000000000].[none:format_label:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0fbengagement000000000000].[med:engagement:qk]' shelf='rows' /></shelf-sorts>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0fbengagement000000000000].[med:engagement:qk]' scope='cols' value='Median engagement rate' />
            <format attr='title' class='0' field='[federated.0fbengagement000000000000].[med:engagement:qk]' scope='rows' value='Median engagement rate' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.0fbengagement000000000000].[none:format_group:nk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-labels-show' value='true' /><format attr='mark-labels-cull' value='false' /></style-rule></style>
          </pane>
        </panes>
        <rows>[federated.0fbengagement000000000000].[none:format_label:nk]</rows>
        <cols>[federated.0fbengagement000000000000].[med:engagement:qk]</cols>
      </table>
      <simple-id uuid='{9DBE65D3-D27E-420A-88C1-C3081F5814F5}' />
    </worksheet>
